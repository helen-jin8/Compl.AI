# Copy to .env and fill. Never commit .env.
ANTHROPIC_API_KEY=
MODEL=claude-opus-4-20250514

# Pioneer. Drafts the outbound copy in scripts/send_email.py. Inference is gated
# behind a Hobby/Pro plan at https://agent.pioneer.ai/billing; an unpaid key
# returns 403 and the script falls back to the template automatically.
PIONEER_API_KEY=
PIONEER_API=https://api.pioneer.ai/v1
PIONEER_MODEL=claude-opus-4-8

# Terac. Mandatory for eligibility. Get from the redemption link in the guidebook.
TERAC_API_KEY=
TERAC_API=https://api.terac.com/v1

# Stripe. Gates Best Overall Agent-Run Company. Payment link only, no secret key.
STRIPE_PAYMENT_LINK=

# Sending. Twenty max from a cold domain.
SEND_FROM=
SENDER_NAME=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAX_SENDS=20
PHYSICAL_ADDRESS=655 Bryant St, San Francisco, CA 94107
UNSUBSCRIBE_URL=

# Sourcing
APIFY_TOKEN=
APIFY_ACTOR=

# Set to 1 to replay every external call from data/cache. Use this on stage.
OFFLINE=0
